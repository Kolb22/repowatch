[Unit]
Description=Synchronize my-app repository using RepoWatch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=repowatch
RuntimeDirectory=repowatch
ExecStart=/usr/bin/flock -n /run/repowatch/my-app.lock /usr/local/bin/repowatch sync --repo /opt/my-app --remote origin --branch main

